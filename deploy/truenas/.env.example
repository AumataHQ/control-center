# Copy to .env beside compose.yaml and fill in. Never commit the real file.

# The single address every service binds to. Use the host's Tailscale address,
# never 0.0.0.0 — Control Center has no login, so this is the access boundary.
BIND_ADDRESS=100.121.13.81

# Where the newsroom's durable state lives on the pool.
NEWSROOM_ROOT=/mnt/Pool/newsroom

# Hostnames Control Center's API answers on, comma separated.
CONTROL_CENTER_ALLOWED_HOSTS=100.121.13.81,truenas-scale.tailed205b.ts.net

# Host port for the dashboard. 3000 is often taken on a NAS.
CONTROL_CENTER_PORT=3010

# Built by deploy/truenas/build-image.sh, or any tag you push yourself.
CONTROL_CENTER_IMAGE=control-center:local

# MinIO credentials. Generate them; do not reuse a password from anywhere else.
#   openssl rand -hex 16   # user
#   openssl rand -hex 32   # password
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
